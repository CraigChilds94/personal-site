{
  "name": "victor-hugo",
  "version": "1.0.0",
  "description": "Victor Hugo is a Hugo boilerplate for creating truly epic websites!",
  "repository": "netlify/victor-hugo",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src",
    "icons": "node scripts/generate-icons.js",
    "start": "run-p start:**",
    "start:hugo": "hugo -d ../dist -s site -w --logLevel info",
    "start:webpack": "webpack serve --config webpack.dev.js",
    "preview": "run-p preview:**",
    "preview:hugo": "npm run start:hugo -- -D -F",
    "preview:webpack": "npm run start:webpack",
    "prebuild": "rimraf dist",
    "build": "npm run build:webpack && npm run build:hugo",
    "build:preview": "npm run build:webpack && npm run build:hugo:preview",
    "build:hugo": "hugo -d ../dist -s site --logLevel info",
    "build:hugo:preview": "npm run build:hugo -- -D -F",
    "build:webpack": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "build:visual": "cross-env NODE_ENV=production OUT_DIR=.visual/site webpack --config webpack.prod.js && hugo -d ../.visual/site -s site --quiet",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "assets-webpack-plugin": "^7.1.1",
    "babel-loader": "^10.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.20.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "hugo-bin": "^0.167.0",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "rimraf": "^6.0.1",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.3.4",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "animate.css": "^4.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
